  .sr-only { clip-path: inset(50%); white-space: nowrap; border-width: 0px;=
 width: 1px; height: 1px; margin: -1px; padding: 0px; overflow: hidden; }
  .absolute, .sr-only { position: absolute; }
  .fixed { position: fixed; }
  .relative { position: relative; }
  .static { position: static; }
  .sticky { position: sticky; }
  .inset-0 { inset: 0px; }
  .inset-x-0 { inset-inline: 0px; }
  .-top-200 { top: -12px; }
