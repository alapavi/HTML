  .left-0 { left: 0px; }
  .left-1\/2 { left: 50%; }
  .left-auto { left: auto; }
  .isolate { isolation: isolate; }
  .z-1 { z-index: 1; }
  .z-2 { z-index: 2; }
  .z-10 { z-index: 10; }
  .z-50 { z-index: 50; }
  .z-2000 { z-index: 2000; }
  .z-\[calc\(var\(--z-index-snackbar\)-var\(--toast-index\)\)\] { z-index: =
